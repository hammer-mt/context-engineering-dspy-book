# Copy this file to .env and add the keys for the examples you want to run.
# Lines that start with "#" are ignored: remove the "# " to enable a variable.

# Required by most notebooks
OPENAI_API_KEY=api_key_goes_here

# Optional provider keys: enable only the ones a notebook asks for
# ANTHROPIC_API_KEY=api_key_goes_here
# GEMINI_API_KEY=api_key_goes_here
# OPENROUTER_API_KEY=api_key_goes_here

# Optional tools and services
# FAL_KEY=api_key_goes_here
# SERPER_API_KEY=api_key_goes_here
# TAVILY_API_KEY=api_key_goes_here

# Optional Qdrant settings for chapter08/rag-qdrant.ipynb
# Local server started with Docker (no API key needed):
# QDRANT_URL=http://127.0.0.1:6333
# Qdrant Cloud: set QDRANT_URL to your cluster URL and add its API key:
# QDRANT_API_KEY=api_key_goes_here
# Collection to query (the notebook uses knowledge_base when this is not set):
# QDRANT_COLLECTION=knowledge_base
